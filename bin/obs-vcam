#!/usr/bin/env python3
"""obs-vcam — start/stop/query the OBS Virtual Camera via obs-websocket v5 (stdlib only).

Usage: obs-vcam start|stop|status
Reads host port/password from OBS's own obs-websocket config.
"""
import base64
import hashlib
import json
import os
import socket
import struct
import sys
import time

CONFIG = os.path.expanduser(
    "~/Library/Application Support/obs-studio/plugin_config/obs-websocket/config.json")
REQUESTS = {"start": "StartVirtualCam", "stop": "StopVirtualCam", "status": "GetVirtualCamStatus"}


def send(sock, obj):
    payload = json.dumps(obj).encode()
    mask = os.urandom(4)
    header = bytes([0x81])
    n = len(payload)
    if n < 126:
        header += bytes([0x80 | n])
    elif n < 65536:
        header += bytes([0x80 | 126]) + struct.pack("!H", n)
    else:
        header += bytes([0x80 | 127]) + struct.pack("!Q", n)
    sock.sendall(header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))


def recv_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("obs-websocket closed the connection")
        buf += chunk
    return buf


def recv(sock):
    _, b2 = recv_exact(sock, 2)
    n = b2 & 0x7F
    if n == 126:
        n = struct.unpack("!H", recv_exact(sock, 2))[0]
    elif n == 127:
        n = struct.unpack("!Q", recv_exact(sock, 8))[0]
    return json.loads(recv_exact(sock, n))


def connect(port, password, timeout):
    deadline = time.time() + timeout
    while True:
        try:
            sock = socket.create_connection(("127.0.0.1", port), timeout=5)
            break
        except OSError:
            if time.time() > deadline:
                sys.exit("obs-vcam: OBS websocket not reachable — is OBS running?")
            time.sleep(0.5)
    key = base64.b64encode(os.urandom(16)).decode()
    sock.sendall((f"GET / HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\n"
                  f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                  "Sec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: obswebsocket.json\r\n\r\n").encode())
    resp = b""
    while b"\r\n\r\n" not in resp:
        resp += sock.recv(1024)
    if b" 101 " not in resp.split(b"\r\n", 1)[0]:
        sys.exit("obs-vcam: websocket upgrade failed")
    hello = recv(sock)["d"]
    identify = {"rpcVersion": 1}
    auth = hello.get("authentication")
    if auth:
        secret = base64.b64encode(hashlib.sha256((password + auth["salt"]).encode()).digest())
        identify["authentication"] = base64.b64encode(
            hashlib.sha256(secret + auth["challenge"].encode()).digest()).decode()
    send(sock, {"op": 1, "d": identify})
    if recv(sock).get("op") != 2:
        sys.exit("obs-vcam: authentication failed")
    return sock


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in REQUESTS:
        sys.exit(__doc__.strip())
    with open(CONFIG) as f:
        cfg = json.load(f)
    sock = connect(cfg.get("server_port", 4455), cfg.get("server_password", ""), timeout=20)
    send(sock, {"op": 6, "d": {"requestType": REQUESTS[sys.argv[1]], "requestId": "1"}})
    d = recv(sock)["d"]
    status = d["requestStatus"]
    # 500 = OutputRunning / 501 = OutputNotRunning: already in the requested state
    if not status["result"] and status["code"] not in (500, 501):
        sys.exit(f"obs-vcam: {status.get('comment', status['code'])}")
    if sys.argv[1] == "status":
        print("on" if d["responseData"]["outputActive"] else "off")


if __name__ == "__main__":
    main()
